# Application
APP_ENV=development
APP_NAME=lead-qualification-routing-agent
APP_VERSION=0.6.5
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_long_random_local_secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
DISPLAY_TIMEZONE=UTC
AUTH_DEVELOPMENT_FALLBACK=true
AUTH_SESSION_COOKIE_NAME=lead_agent_session
AUTH_CSRF_COOKIE_NAME=lead_agent_csrf
VITE_AUTH_CSRF_COOKIE_NAME=lead_agent_csrf
AUTH_SESSION_HOURS=336
AUTH_COOKIE_SECURE=false

# Persistence and jobs
# Local-only Docker Compose credentials; replace with managed secrets outside development.
DATABASE_URL=postgresql+psycopg://lead_agent:lead_agent@localhost:5432/lead_agent
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=lead-processing
JOB_MAX_RETRIES=3

# Versioned application configuration
ICP_CONFIG_PATH=config/icp.example.yaml
ROUTING_CONFIG_PATH=config/routing.example.yaml
CRM_CONFIG_PATH=config/crm.example.yaml

# Reasoning provider: deterministic | openai. Deterministic requires no credentials.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=replace_with_approved_model_id
OPENAI_ORG_ID=replace_with_openai_organization_id_if_required
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_STORE_RESPONSES=false

# CRM provider: mock | salesforce | hubspot. Mock is credential-free.
CRM_PROVIDER=mock
CRM_MAX_ATTEMPTS=3
CRM_TIMEOUT_SECONDS=20
SECRET_STORE_PROVIDER=development
OAUTH_BROKER=development
INTEGRATION_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
# Operator-owned OAuth application credentials. Customers never enter these values.
SALESFORCE_CLIENT_ID=replace_with_salesforce_client_id
SALESFORCE_CLIENT_SECRET=replace_with_salesforce_client_secret
SALESFORCE_REFRESH_TOKEN=replace_with_salesforce_refresh_token
SALESFORCE_LOGIN_BASE_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v68.0
HUBSPOT_ACCESS_TOKEN=replace_with_hubspot_private_app_token
HUBSPOT_CLIENT_ID=replace_with_hubspot_oauth_client_id
HUBSPOT_CLIENT_SECRET=replace_with_hubspot_oauth_client_secret
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# Notifications: mock | slack. Mock is credential-free and safe for local development.
NOTIFICATION_PROVIDER=mock
SLACK_BOT_TOKEN=replace_with_slack_bot_token
SLACK_CLIENT_ID=replace_with_slack_oauth_client_id
SLACK_CLIENT_SECRET=replace_with_slack_oauth_client_secret
SLACK_SIGNING_SECRET=replace_with_slack_signing_secret
SLACK_CHANNEL_ID=replace_with_slack_channel_id

# Mailbox: Gmail or Microsoft Graph (not implemented in this phase)
MAILBOX_PROVIDER=none
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=replace_with_google_refresh_token
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback
MICROSOFT_TENANT_ID=replace_with_microsoft_tenant_id
MICROSOFT_CLIENT_ID=replace_with_microsoft_client_id
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/v1/auth/microsoft/callback

# LinkedIn / optional social channel (not implemented in this phase)
LINKEDIN_CLIENT_ID=replace_with_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=replace_with_linkedin_access_token
LINKEDIN_WEBHOOK_SECRET=replace_with_linkedin_webhook_secret
SOCIAL_PROVIDER=none
SOCIAL_ACCESS_TOKEN=replace_with_social_provider_access_token
SOCIAL_WEBHOOK_SECRET=replace_with_social_webhook_secret

# Security, demo, and telemetry
WEBHOOK_SIGNING_SECRET=replace_with_webhook_signing_secret
DEMO_DATA_ENABLED=false
# Optional frontend workspace selection. This reserved value is the explicit demo workspace.
VITE_WORKSPACE_ID=00000000-0000-0000-0000-000000000006
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=replace_with_sentry_dsn_if_used
