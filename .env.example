# Environment
# APP_ENV: development | test | production. Production enables fail-closed validation.
APP_ENV=development
APP_NAME=lead-qualification-routing-agent
APP_VERSION=0.6.5
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Development uses readable text. Production requires JSON for log ingestion.
LOG_FORMAT=text
OBSERVABILITY_ENABLED=true
DISPLAY_TIMEZONE=UTC

# Database and Redis
# Development defaults only. Production requires explicitly managed endpoints/credentials.
DATABASE_URL=postgresql+psycopg://lead_agent:lead_agent@localhost:5432/lead_agent
# Production requires PostgreSQL over TLS; choose require or verify-full per deployment policy.
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_RETRY_ON_TIMEOUT=true
QUEUE_NAME=lead-processing
JOB_MAX_RETRIES=3
CRM_INBOUND_SCHEDULER_INTERVAL_SECONDS=60
CRM_INBOUND_DEFAULT_INTERVAL_SECONDS=300
CRM_INBOUND_BATCH_LIMIT=500
CRM_INBOUND_PAGE_SIZE=100

# Shared distributed rate limiting; production requires redis and a rediss:// URL.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_AUTHENTICATION_MAX=10
RATE_LIMIT_AUTHENTICATION_WINDOW_SECONDS=60
RATE_LIMIT_OAUTH_MAX=12
RATE_LIMIT_OAUTH_WINDOW_SECONDS=300
RATE_LIMIT_CREDENTIALS_MAX=5
RATE_LIMIT_CREDENTIALS_WINDOW_SECONDS=300
RATE_LIMIT_PROVIDER_ACTIONS_MAX=20
RATE_LIMIT_PROVIDER_ACTIONS_WINDOW_SECONDS=60
RATE_LIMIT_AGENT_MAX=30
RATE_LIMIT_AGENT_WINDOW_SECONDS=60

# Authentication and sessions
# SECRET_KEY and WEBHOOK_SIGNING_SECRET are production-required, unique random values (32+ chars).
SECRET_KEY=replace_with_a_unique_random_secret_of_at_least_32_characters
AUTH_SESSION_COOKIE_NAME=lead_agent_session
AUTH_CSRF_COOKIE_NAME=lead_agent_csrf
AUTH_SESSION_HOURS=336
# Production required: true. SameSite=None also requires Secure=true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Development/test only. Production requires false and hides the development-session endpoint.
AUTH_DEVELOPMENT_FALLBACK=true
WEBHOOK_SIGNING_SECRET=replace_with_a_unique_webhook_secret_of_at_least_32_characters

# Frontend, API, CORS, and OAuth callback URLs
# Production requires explicit HTTPS origins; wildcard credentialed CORS is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173
INTEGRATION_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173
# Public Vite values only. Never place server credentials in VITE_* variables.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_ALLOWED_HOSTS=localhost
VITE_AUTH_CSRF_COOKIE_NAME=lead_agent_csrf
# Development only: initial local workspace selection hint; never authorization.
VITE_WORKSPACE_ID=00000000-0000-0000-0000-000000000006

# Secret management
# Development/test use process-local storage. Production requires "managed" plus a deployment
# adapter factory in package.module:factory form. The adapter may target AWS, Azure, GCP, or Vault.
SECRET_STORE_PROVIDER=development
MANAGED_SECRET_STORE_BACKEND=lead_agent.infrastructure.encrypted_secrets:create_backend
# Base64url-encoded 32-byte AES-256 key. Inject from deployment secrets; never commit a value.
SECRET_STORE_ENCRYPTION_KEY=replace_with_base64url_encoded_32_byte_key
SECRET_STORE_KEY_VERSION=v1
# JSON object of prior key-version to base64url key mappings during master-key rotation.
SECRET_STORE_PREVIOUS_KEYS={}

# Versioned application policy
ICP_CONFIG_PATH=config/icp.example.yaml
ROUTING_CONFIG_PATH=config/routing.example.yaml
CRM_CONFIG_PATH=config/crm.example.yaml

# OAuth broker and operator-owned provider applications
# Development/test may use the deterministic broker. Production requires "provider".
OAUTH_BROKER=development
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=replace_with_microsoft_oauth_client_id
MICROSOFT_CLIENT_SECRET=replace_with_microsoft_oauth_client_secret
SLACK_CLIENT_ID=replace_with_slack_oauth_client_id
SLACK_CLIENT_SECRET=replace_with_slack_oauth_client_secret
HUBSPOT_CLIENT_ID=replace_with_hubspot_oauth_client_id
HUBSPOT_CLIENT_SECRET=replace_with_hubspot_oauth_client_secret
LINKEDIN_CLIENT_ID=replace_with_linkedin_oauth_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_oauth_client_secret
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# CRM selection
# Development uses mock. Production resolves an active workspace CRM connection; operator OAuth
# application credentials remain required, while workspace refresh tokens stay in the secret store.
CRM_PROVIDER=mock
CRM_MAX_ATTEMPTS=3
EXPORT_SYNC_LIMIT=5000
CRM_TIMEOUT_SECONDS=20
# Optional development-only fallback token; real OAuth workspace connections do not use this.
SALESFORCE_REFRESH_TOKEN=
SALESFORCE_LOGIN_BASE_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v68.0
HUBSPOT_ACCESS_TOKEN=replace_with_hubspot_private_app_token
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# Notifications
# Development uses mock. Production requires Slack with deployment-injected values.
NOTIFICATION_PROVIDER=mock
SLACK_BOT_TOKEN=replace_with_slack_bot_token
SLACK_CHANNEL_ID=replace_with_slack_channel_id

# OpenAI
# Deterministic is credential-free for development/test. Production requires OpenAI with both values.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=replace_with_openai_project_api_key
OPENAI_MODEL=replace_with_approved_model_id
OPENAI_ORG_ID=replace_with_openai_organization_id_if_required
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_STORE_RESPONSES=false

# Optional/future provider boundaries
MAILBOX_PROVIDER=none
SOCIAL_PROVIDER=none

# Demo and telemetry
# Demo data is always seeded by an explicit command into the reserved demo workspace only.
# Production requires false and all seed commands are disabled in production.
DEMO_DATA_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=replace_with_sentry_dsn_if_used
