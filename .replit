entrypoint = "scripts/replit_start.sh"
run = "bash scripts/replit_start.sh"
modules = ["python-3.12", "web", "bash", "nodejs-22", "postgresql-16"]

[deployment]
build = "bash scripts/replit_build.sh"
run = "bash scripts/replit_start.sh"
deploymentTarget = "gce"
ignorePorts = false

[nix]
channel = "stable-25_05"
packages = ["mailpit", "redis"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Corral preview"

[[workflows.workflow]]
name = "Corral preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit_dev.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 3000

[userenv]

[userenv.shared]
VITE_RINGCENTRAL_EMBED_CLIENT_ID = "no have it yet"

[userenv.production]
EMAIL_PROVIDER = "gmail"
REDIS_DEPLOYMENT_MODE = "local_vm"
REDIS_URL = "redis://127.0.0.1:6380/0"
CORS_ALLOWED_ORIGINS = "https://corralai.tech,https://www.corralai.tech,https://lead-qualification-routing-agent.replit.app"
FRONTEND_PUBLIC_BASE_URL = "https://corralai.tech"
INTEGRATION_PUBLIC_BASE_URL = "https://corralai.tech"
OAUTH_BROKER = "provider"

[postMerge]
path = "scripts/replit_build.sh"
timeoutMs = 180000
